{
  "name": "agent-hub-ui",
  "version": "0.4.0",
  "description": "Local web dashboard that monitors the coding agents running on this PC and shows what they are doing, live.",
  "license": "MIT",
  "author": "Uğur Demir (https://github.com/UurDemir)",
  "type": "module",
  "bin": {
    "agent-hub-ui": "bin/agent-hub.js",
    "agent-hub": "bin/agent-hub.js"
  },
  "files": [
    "bin/",
    "server/",
    "public/"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node server/index.js",
    "open": "node server/index.js --open",
    "test": "node --test"
  },
  "keywords": [
    "claude-code",
    "claude",
    "ai-agents",
    "coding-agents",
    "dashboard",
    "monitoring",
    "subagents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UurDemir/agent-hub-ui.git"
  },
  "homepage": "https://github.com/UurDemir/agent-hub-ui#readme",
  "bugs": {
    "url": "https://github.com/UurDemir/agent-hub-ui/issues"
  }
}
